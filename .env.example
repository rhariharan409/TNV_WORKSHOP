# TNV Workshop - Supabase Configuration Example
# Copy this file to .env and replace the values with your actual Supabase project credentials.
# Obtain these from: Supabase Dashboard > Project Settings > API

# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
# NOTE: Do NOT include /rest/v1 at the end of the URL.
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anon / Publishable Key (e.g. sb_publishable_... or eyJhbGciOi...)
# CRITICAL SECURITY NOTE:
# NEVER place your 'service_role' or 'sb_secret_...' key here.
# Variables prefixed with VITE_ are compiled into public frontend JavaScript bundles.
# Only use the anon/publishable key!
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key-here

# Optional Application Settings
VITE_APP_NAME="TNV Workshop"
VITE_APP_URL=http://localhost:5173
VITE_DEFAULT_WHATSAPP_URL=https://chat.whatsapp.com/sample-tnv-workshop
